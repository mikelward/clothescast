<?xml version="1.0" encoding="utf-8"?>
<!--
  "DEV" badge overlaid on the local/debug build's launcher icon (see
  ic_launcher_foreground_construction). Drawn on the full 108x108dp adaptive-icon
  canvas and positioned within the central safe zone — the 66dp-diameter circle
  every launcher mask preserves — so it survives a Pixel circle / squircle crop.
  An earlier version pinned the banner to the bottom edge (gravity="bottom"),
  which sat entirely in the outer 18dp bleed the system always clips, so the
  badge vanished on every masked launcher. The banner (x 36..72, y 61..75) and
  its "DEV" text stay inside the safe circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFC107"
        android:pathData="M36,61 H72 V75 H36 Z" />

    <!--
      "DEV" text, authored in a 0..14 band and shifted down into the banner by
      the group's translateY. Keeping the glyphs in their original coordinates
      (rather than baking the offset in) lets the badge and its monochrome
      sibling share the same source paths.
    -->
    <group android:translateY="61">
        <path
            android:fillColor="#1A1A1A"
