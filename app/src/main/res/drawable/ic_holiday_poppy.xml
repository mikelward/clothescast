<?xml version="1.0" encoding="utf-8"?>
<!-- Remembrance poppy: four red petals around a black centre. Drawn rather
     than an emoji because Unicode has no poppy. Fixed colors on purpose:
     it's a symbol, not a tinted icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Back petals (left/right), a shade darker so the layers read. -->
    <path
        android:fillColor="#B71C1C"
        android:pathData="M2,12a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0zM11,12a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0z" />
    <!-- Front petals (top/bottom). -->
    <path
        android:fillColor="#E53935"
        android:pathData="M6.5,7.5a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0zM6.5,16.5a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0z" />
    <!-- Centre. -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M9,12a3,3 0 1,0 6,0a3,3 0 1,0 -6,0z" />
</vector>
