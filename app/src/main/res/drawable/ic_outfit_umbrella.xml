<vector xmlns:android="http://schemas.android.com/apk/res/android" android:width="48dp" android:height="96dp" android:viewportWidth="96" android:viewportHeight="192">

    <!-- Furled umbrella as the avatar would hold it: gripped at the hand by the
         right hip and hanging straight down the side with gravity, the crook up
         near the waist and the canopy + ferrule running down past the legs to
         the ankle. Authored at a full-figure 96x192 viewport (torso 0-96, legs
         96-192) so a same-height overlay spans both the top and bottom icons,
         sitting in the empty space beside the body on the right. -->

    <!-- Crook handle: the hand grips this hook at the hip. -->
    <path android:strokeColor="#4E342E" android:strokeWidth="4" android:strokeLineJoin="round" android:strokeLineCap="round" android:pathData="M82,93 L82,80 Q82,73 75,73 Q68,73 68,80" />

    <!-- Furled canopy: gathered fabric under the grip, a slim bulge, then a long
         taper to a soft point above the ferrule. -->
    <path android:fillColor="#2D6CDF" android:strokeColor="#163F7E" android:strokeWidth="2" android:strokeLineJoin="round" android:strokeLineCap="round" android:pathData="M79,94 Q76,92 79,90 Q82,88 85,90 Q88,92 85,94 L87,132 Q88,158 83,172 L82,180 L81,172 Q76,158 77,132 Z" />

    <!-- Ferrule tip: a small straight metal point below the canopy, near the ankle. -->
    <path android:fillColor="#546E7A" android:strokeColor="#37474F" android:strokeWidth="0.9" android:strokeLineJoin="round" android:strokeLineCap="round" android:pathData="M81.3,180 L81.3,185 L82,187 L82.7,185 L82.7,180 Z" />

    <!-- Two furl lines hinting at the rolled-up panels. -->
    <path android:strokeColor="#163F7E" android:strokeWidth="1.3" android:strokeLineCap="round" android:pathData="M81,94 Q79,137 82,178" />
    <path android:strokeColor="#163F7E" android:strokeWidth="1.3" android:strokeLineCap="round" android:pathData="M83,94 Q85,137 82,178" />

    <!-- Closure strap wrapping the bundle — a strong "it's closed" cue. -->
    <path android:fillColor="#14366B" android:strokeColor="#0E2A55" android:strokeWidth="1" android:strokeLineJoin="round" android:pathData="M77,99 L87,99 Q89,102 87,105 L77,105 Q75,102 77,99 Z" />

</vector>
