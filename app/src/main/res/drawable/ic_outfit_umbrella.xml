    <path android:fillColor="#546E7A" android:strokeColor="#37474F" android:strokeWidth="1" android:strokeLineJoin="round" android:strokeLineCap="round" android:pathData="M47.3,85 L47.3,90 L48,91.5 L48.7,90 L48.7,85 Z" />

