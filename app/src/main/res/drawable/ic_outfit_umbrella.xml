<vector xmlns:android="http://schemas.android.com/apk/res/android" android:width="48dp" android:height="96dp" android:viewportWidth="96" android:viewportHeight="192">

    <!-- Furled umbrella as the avatar would hold it: the crook handle is grasped
         in the right hand (the hand/glove position sits around x76-95, y73-92 on
         the top icon), with the shaft, furled canopy, and ferrule tip hanging
         straight down with gravity past the legs to the ankle. Authored at a
         full-figure 96x192 viewport (torso 0-96, legs 96-192) so a same-height
         overlay spans both the top and bottom icons, in the empty space beside
         the body on the right. -->

    <!-- Crook handle: the hand grasps this hook; the curl sits in the middle of
         the hand. Drawn first so the canopy's gathered top tucks under the shaft. -->
    <path android:strokeColor="#4E342E" android:strokeWidth="4" android:strokeLineJoin="round" android:strokeLineCap="round" android:pathData="M84,96 L84,84 Q84,77 89,77 Q94,77 94,82" />

    <!-- Furled canopy: gathered fabric under the grip, a slim bulge, then a long
         taper to a soft point above the ferrule. -->
    <path android:fillColor="#2D6CDF" android:strokeColor="#163F7E" android:strokeWidth="2" android:strokeLineJoin="round" android:strokeLineCap="round" android:pathData="M81,98 Q78,96 81,94 Q84,92 87,94 Q90,96 87,98 L89,136 Q90,162 85,176 L84,184 L83,176 Q78,162 79,136 Z" />

    <!-- Ferrule tip: a small straight metal point below the canopy, near the ankle. -->
    <path android:fillColor="#546E7A" android:strokeColor="#37474F" android:strokeWidth="0.9" android:strokeLineJoin="round" android:strokeLineCap="round" android:pathData="M83.3,184 L83.3,189 L84,191 L84.7,189 L84.7,184 Z" />

    <!-- Two furl lines hinting at the rolled-up panels. -->
    <path android:strokeColor="#163F7E" android:strokeWidth="1.3" android:strokeLineCap="round" android:pathData="M83,98 Q81,141 84,182" />
    <path android:strokeColor="#163F7E" android:strokeWidth="1.3" android:strokeLineCap="round" android:pathData="M85,98 Q87,141 84,182" />

    <!-- Closure strap wrapping the bundle — a strong "it's closed" cue. -->
    <path android:fillColor="#14366B" android:strokeColor="#0E2A55" android:strokeWidth="1" android:strokeLineJoin="round" android:pathData="M79,103 L89,103 Q91,106 89,109 L79,109 Q77,106 79,103 Z" />

</vector>
