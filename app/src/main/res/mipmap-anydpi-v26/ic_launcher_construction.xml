<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_construction" />
    <!--
      No <monochrome> here on purpose. The construction variant is the
      local/debug build's icon and must stay visually distinct from release
      (it carries the under-construction badge). A monochrome layer would let
      Android 13+ themed icons tint it to the same badge-less silhouette as
      release, erasing that distinction — so the dev variant opts out of
      themed icons and falls back to its full-color badged icon instead.
    -->
</adaptive-icon>
