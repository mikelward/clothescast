    <string name="settings_alerts_channel">Warning sound and lock screen</string>
    <string name="settings_alerts_notification_permission">Without notification permission, severe weather warnings can\'t reach you. Grant it so they can.</string>
    <string name="settings_alerts_status_unsupported">Warnings aren\'t available for this location.</string>
    <string name="settings_alerts_status_none">No warnings for this location. Last checked %1$s</string>
