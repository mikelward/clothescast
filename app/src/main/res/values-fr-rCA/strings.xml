<?xml version="1.0" encoding="utf-8"?>
<!--
Quebec French overrides on top of values-fr/strings.xml. Only vocabulary that
a Quebec speaker would notice as wrong is overridden here; everything else
falls through to the base French translation.
-->
<resources>
    <!-- "Chandail" is the standard Quebec word; "pull" (France) sounds foreign. -->
    <string name="garment_sweater">Chandail</string>
    <string name="today_outfit_top_sweater">Chandail</string>

    <!-- Quebec French uses "bogue" for software bugs where France French
         carries the English loanword "bug". Both verb-form ("signaler
         un bogue") and noun-form ("rapport de bogue") covered. -->
    <string name="today_report_a_bug">Signaler un bogue</string>
    <string name="settings_about_share_bug_report">Partager un rapport de bogue</string>

    <!-- The four strings below contain "bug(s)" in the base French translation;
         Quebec French uses "bogue(s)" throughout. -->
    <string name="bug_report_consent_title">Partager le rapport de bogue ?</string>
    <string name="today_crash_banner_body">Un rapport de plantage a été enregistré sur ton appareil. Le partager pour corriger le bogue ? Rien n\'est envoyé tant que tu n\'as pas choisi où.</string>
    <string name="today_telemetry_notice_body">ClothesCast envoie des rapports de plantage anonymes et des analyses d\'utilisation pour corriger les bogues. Aucune donnée de calendrier, position ou texte de résumé n\'est incluse. Désactive-le à tout moment dans les Paramètres.</string>
    <string name="settings_privacy_telemetry_description">Envoie des rapports de plantage anonymes et des statistiques d\'utilisation agrégées pour aider le développeur à corriger les bogues et décider quelles fonctionnalités conserver.</string>

    <!-- Quebec French spells the imperial mile "Mille" (plur. "Milles");
         France carries the English loan "Miles" since the unit is
         basically only used in en-imported software. -->
    <string name="settings_distance_unit_miles">Milles</string>
</resources>
