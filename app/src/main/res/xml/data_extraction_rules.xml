<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's Auto Backup (Google cloud backup) and device-to-device transfer
  carry. An <include> list, so anything not named here stays behind — a new store
  is left out until someone decides it belongs (DataExtractionRulesTest makes
  them decide).

  Carried: the user's choices.
  - settings: every preference, the wardrobe, schedules, a chosen location.
  - secure_key_store: API-key and broker-password ciphertext only. The Tink
    keyset that decrypts it (clothescast_master_prefs) is sealed by an Android
    Keystore key that never leaves the device, so it is not carried and the new
    install can't decrypt. That is on purpose: a Gemini key that fails to decrypt
    marks itself as needing re-entry, keeping your own-key requests off the
    shared proxy until you re-enter it; the MQTT and Google slots clear
    themselves on first use.
  - app_locale: the in-app language override (Android 12; 13+ keeps it in the system).

  Left behind: caches (forecast, insight, alerts, daily history), alarm and
  widget-refresh state, WorkManager's database, the Tink keyset, Firebase sign-in
  and installation IDs, and logs.

  Cloud backup runs only where Android can encrypt it end to end with the
  screen lock, since settings can hold a chosen location.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/secure_key_store.preferences_pb" />
        <include domain="sharedpref" path="app_locale.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/secure_key_store.preferences_pb" />
        <include domain="sharedpref" path="app_locale.xml" />
    </device-transfer>
</data-extraction-rules>
