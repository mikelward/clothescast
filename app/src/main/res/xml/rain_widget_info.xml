<?xml version="1.0" encoding="utf-8"?>
<!--
    AppWidget metadata for the chance-of-rain chart widget. Same footprint as
    the feels-like chart (a chart needs width to read; roughly 4x2 cells on a
    110dp grid) and resizable. updatePeriodMillis is 0 because Glance refreshes
    are pushed by the fetch worker via updateAllClothesCastWidgets() — no
    polling.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@drawable/widget_preview_rain"
    android:description="@string/rain_widget_description" />
