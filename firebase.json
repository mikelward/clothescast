{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "scripts"
      ],
      "predeploy": ["cd \"$RESOURCE_DIR\" && node node_modules/typescript/bin/tsc"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true }
  }
}
