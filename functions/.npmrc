# Refuse to resolve any version published less than this many DAYS ago —
# npm's own definition declares the option with `hint: '<days>'` and flattens
# it to `--before` as `Date.now() - 86400000 * value` (one day in ms), so 5
# here is five days, not five seconds or minutes.
#
# The weekly npm-update workflow resolves whatever each package.json range
# allows at the moment it runs, so without a cooldown a malicious or broken
# release published minutes earlier lands in that Saturday's batch. Five days
# is long enough for the ecosystem to catch and yank a bad release, and it
# matches the window the other npm repos here use.
#
# Only affects resolution — `npm ci` installs from the lockfile without
# resolving, so CI and deploys are unchanged. It bites exactly where wanted:
# the weekly `npm update` and `npm install` locally.
#
# The option landed in npm 11.10.0 and is silently ignored before that
# ("Unknown project config"), so package.json declares engines.npm and the
# workflow checks the runner's npm against it before resolving anything.
#
# If the window ever blocks an `npm audit fix`, npm keeps the vulnerable
# version and exits non-zero rather than failing quietly — add the package to
# min-release-age-exclude to take the fix immediately.
min-release-age=5
