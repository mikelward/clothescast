{
  "name": "clothescast-functions",
  "private": true,
  "description": "Cloud Functions backing clothescast — currently just the Gemini TTS proxy.",
  "engines": {
    "node": "22",
    "npm": ">=11.10.0"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "echo 'No lint configured yet for the Functions tree.'",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/express": "^4",
    "@types/node": "^22",
    "express": "^4",
    "fast-xml-parser": "~5.8.0"
  }
}
